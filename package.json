{
  "private": true,
  "type": "module",
  "author": "Gonzalo Pabón Flores <zalo.pabon@gmail.com> (https://github.com/ZaloSpace)",
  "scripts": {
    "js-lint": "./node_modules/.bin/eslint ./resources/js/**/*.vue ./resources/js/**/*.js --fix",
    "style-lint": "./node_modules/.bin/stylelint resources/css/**/* --fix",
    "php-lint": "./vendor/bin/pint --preset laravel ./**/*.php",
    "prettier": "prettier --write . --fix",
    "dev": "vite --host",
    "build": "vite build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inertiajs/vite": "^3.11.0",
    "@inertiajs/vue3": "^3.11.0",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "axios": "^1.21.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^3.2.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "gsap": "^3.15.1",
    "laravel-echo": "^2.6.3",
    "laravel-vue-i18n": "^2.9.0",
    "lodash": "^4.18.1",
    "pinia": "^4.1.0",
    "pluralize": "^8.0.0",
    "qs": "^6.14.0",
    "ziggy-js": "^2.6.5"
  },
  "lint-staged": {
    "resources/{js,vue}/**/*.{js,vue}": [
      "eslint --fix"
    ],
    "**/*.css": "stylelint --fix",
    "**/*.php": "./vendor/bin/pint --preset laravel"
  }
}
